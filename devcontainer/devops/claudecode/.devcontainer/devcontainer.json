{
  "name": "ccdevops",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--network",
    "app32"
  ],
  "containerEnv": {
    "HTTP_PROXY": "http://host.docker.internal:7890",
    "HTTPS_PROXY": "http://host.docker.internal:7890",
    "NO_PROXY": "localhost,127.0.0.1"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "settings": {
        "yaml.customTags": [
          "!vault scalar",
          "!include_dir_named scalar",
          "!include_vars scalar",
          "!include scalar",
          "!encrypted/pkcs1-oaep scalar"
        ],
        "yaml.format.enable": true,
        "yaml.validate": true,
        "ansible.ansible.useFullyQualifiedCollectionNames": true,
        "ansible.validation.enabled": true,
        "ansible.validation.lint.enabled": true,
        "ansible.validation.lint.path": "ansible-lint",
        "docker.showStartPage": false,
        "shellcheck.executablePath": "shellcheck",
        "shellformat.effectLanguages": ["shellscript"],
        "shellformat.path": "/usr/local/bin/shfmt",
        "terraform.experimentalFeatures.validateOnSave": true,
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "[terraform]": {
          "editor.defaultFormatter": "hashicorp.terraform"
        },
        "[shellscript]": {
          "editor.defaultFormatter": "foxundermoon.shell-format"
        },
        "[dockerfile]": {
          "editor.defaultFormatter": "ms-azuretools.vscode-docker"
        }
      },
      "extensions": [
        "redhat.vscode-yaml",
        "redhat.ansible",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "hashicorp.terraform",
        "wholroyd.hcl",
        "timonwong.shellcheck",
        "foxundermoon.shell-format",
        "wholroyd.jinja",
        "mechatroner.rainbow-csv",
        "emilast.logfilehighlighter",
        "anthropic.claude-code"
      ]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder:HOME}/.devcontainer,target=/workspace/.devcontainer,type=bind,consistency=cached",
    "source=ccdevops-cc,target=/home/vscode/.claude,type=volume",
    "source=${localEnv:HOME}/.claude/settings,target=/home/vscode/.claude/settings,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude/plugins/claude-hud/config.json,target=/home/vscode/.claude/plugins/claude-hud/config.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/llm-providers,target=/home/vscode/.config/llm-providers,type=bind,consistency=cached"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteUser": "vscode"
}
